<Window x:Class="WinClickWpf.Views.PresetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пресеты и точка восстановления"
        Width="700" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#141619"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1E2228"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5E81AC"/>

        <!-- Preset Card Button Style -->
        <Style x:Key="PresetCardBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#1A1E24"/>
            <Setter Property="BorderBrush" Value="#335E81AC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,0,14,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A303A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5E81AC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0,14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4C566A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Background" Value="#252A32"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#335E81AC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D4450"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DarkBgBrush}" CornerRadius="12" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="20" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="DialogScale" ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Fill="#88C0D0" Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2v9.67z"/>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="Пресеты и точка восстановления"
                                   FontFamily="Bahnschrift"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="#88C0D0"/>
                        <TextBlock Text="Быстрый выбор готовых сценариев, сохранение в JSON и создание бэкапа Windows"
                                   FontFamily="Bahnschrift"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Border Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnCloseClick" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <TextBlock Text="✕" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Restore Point Banner -->
            <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="#33808080" BorderThickness="1" CornerRadius="8" Padding="14,10,14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="📸 Контрольная точка восстановления системы" FontWeight="Bold" Foreground="White" FontSize="12" FontFamily="Bahnschrift"/>
                        <TextBlock Text="Создает снимок реестра и системных файлов Windows перед оптимизацией." FontSize="10" Foreground="#888888" FontFamily="Bahnschrift" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="СОЗДАТЬ ТОЧКУ" Style="{StaticResource PrimaryBtnStyle}" Height="30" FontSize="11" Click="OnCreateRestorePointClick"/>
                </Grid>
            </Border>

            <!-- Presets Grid -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Built-in Presets -->
                <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="#33808080" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="🎯 Готовые сценарии настройки:" FontWeight="Bold" Foreground="White" FontSize="12" FontFamily="Bahnschrift" Margin="0,0,0,10"/>

                        <!-- Preset 1: Gaming -->
                        <Button Style="{StaticResource PresetCardBtnStyle}" Click="OnPresetGamingClick">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🎮 Игровой ПК (Ultimate Gaming)" FontWeight="Bold" Foreground="#88C0D0" FontSize="11" FontFamily="Bahnschrift"/>
                                <TextBlock Text="Сжатие, задержки, разгрузка CPU, UWP и телеметрия." FontSize="9" Foreground="#888888" FontFamily="Bahnschrift"/>
                            </StackPanel>
                        </Button>

                        <!-- Preset 2: Privacy -->
                        <Button Style="{StaticResource PresetCardBtnStyle}" Click="OnPresetPrivacyClick">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🛡️ Максимальная приватность" FontWeight="Bold" Foreground="#A3BE8C" FontSize="11" FontFamily="Bahnschrift"/>
                                <TextBlock Text="Отключение Edge, телеметрии, рекламы и слежки." FontSize="9" Foreground="#888888" FontFamily="Bahnschrift"/>
                            </StackPanel>
                        </Button>

                        <!-- Preset 3: Office -->
                        <Button Style="{StaticResource PresetCardBtnStyle}" Click="OnPresetOfficeClick">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="💼 Офис и учеба (Safe Workstation)" FontWeight="Bold" Foreground="#EBCB8B" FontSize="11" FontFamily="Bahnschrift"/>
                                <TextBlock Text="Очистка кэшей, темная тема, ускорение папок." FontSize="9" Foreground="#888888" FontFamily="Bahnschrift"/>
                            </StackPanel>
                        </Button>

                        <!-- Preset 4: Clean -->
                        <Button Style="{StaticResource PresetCardBtnStyle}" Click="OnPresetCleanClick">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🧹 Сбросить все галочки" FontWeight="Bold" Foreground="#BF616A" FontSize="11" FontFamily="Bahnschrift"/>
                                <TextBlock Text="Снять выбор со всех пунктов программы." FontSize="9" Foreground="#888888" FontFamily="Bahnschrift"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right: Export / Import JSON -->
                <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" BorderBrush="#33808080" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="💾 Экспорт и Импорт профилей:" FontWeight="Bold" Foreground="White" FontSize="12" FontFamily="Bahnschrift" Margin="0,0,0,10"/>
                        <TextBlock Text="Вы можете сохранить ваш текущий набор галочек в файл .json, чтобы перенести его на другой ПК или поделиться с друзьями."
                                   FontSize="10" Foreground="#888888" FontFamily="Bahnschrift" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Button Content="📤 ЭКСПОРТ В JSON ФАЙЛ" Style="{StaticResource SecondaryBtnStyle}" Height="40" Margin="0,0,0,10" Click="OnExportJsonClick"/>
                        <Button Content="📥 ИМПОРТ ИЗ JSON ФАЙЛА" Style="{StaticResource SecondaryBtnStyle}" Height="40" Click="OnImportJsonClick"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
