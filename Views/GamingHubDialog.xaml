<Window x:Class="WinClickWpf.Views.GamingHubDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Игровой хаб и задержки (Gaming &amp; Latency)"
        Width="750" Height="630"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#141619"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1E2228"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5E81AC"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C566A"/>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0,14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4C566A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Background" Value="#252A32"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#335E81AC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D4450"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DarkBgBrush}" CornerRadius="12" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="20" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="DialogScale" ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Fill="#88C0D0" Data="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="Игровой хаб и задержки (Gaming &amp; Latency Hub)"
                                   FontFamily="Bahnschrift"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="#88C0D0"/>
                        <TextBlock Text="Настройка MSI Mode прерываний GPU, системных таймеров и сетевого стека"
                                   FontFamily="Bahnschrift"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Border Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnCloseClick" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <TextBlock Text="✕" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Navigation Tabs -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" x:Name="TabMsi" Background="#5E81AC" CornerRadius="7" Height="34" Cursor="Hand" MouseLeftButtonDown="OnTabMsiClick">
                    <TextBlock Text="🎮 MSI Mode (GPU)" FontWeight="Bold" FontFamily="Bahnschrift" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Column="2" x:Name="TabTimers" Background="#1E2228" BorderBrush="#33808080" BorderThickness="1" CornerRadius="7" Height="34" Cursor="Hand" MouseLeftButtonDown="OnTabTimersClick">
                    <TextBlock Text="⏱️ Таймеры BCDedit" FontWeight="Bold" FontFamily="Bahnschrift" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Column="4" x:Name="TabNetwork" Background="#1E2228" BorderBrush="#33808080" BorderThickness="1" CornerRadius="7" Height="34" Cursor="Hand" MouseLeftButtonDown="OnTabNetworkClick">
                    <TextBlock Text="🌐 Сеть и Пинг" FontWeight="Bold" FontFamily="Bahnschrift" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Column="6" x:Name="TabPower" Background="#1E2228" BorderBrush="#33808080" BorderThickness="1" CornerRadius="7" Height="34" Cursor="Hand" MouseLeftButtonDown="OnTabPowerClick">
                    <TextBlock Text="⚡ Питание CPU" FontWeight="Bold" FontFamily="Bahnschrift" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Tab Contents -->
            <Grid Grid.Row="2">
                <!-- Panel 1: MSI Mode -->
                <Grid x:Name="PanelMsi" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="12,8,12,8" Margin="0,0,0,10" BorderBrush="#33808080" BorderThickness="1">
                        <TextBlock Text="💡 MSI (Message Signaled-Based Interrupts) переводит устройства с медленных линий IRQ на прямое сообщение с памятью, устраняя задержки и микрофризы видеокарты."
                                   FontSize="11" Foreground="#CCCCCC" FontFamily="Bahnschrift" TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="8" BorderBrush="#33808080" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListMsiDevices">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#16191E" CornerRadius="6" BorderBrush="#252A32" BorderThickness="1" Margin="0,0,0,6" Padding="12,10,12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                                        <Border Background="#252A32" CornerRadius="4" Padding="6,2,6,2" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding DeviceType}" FontSize="9" Foreground="#88C0D0"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DevicePath}" FontSize="9" Foreground="#666666" Margin="0,2,0,0" FontFamily="Consolas"/>
                                                </StackPanel>

                                                <!-- Priority Badge -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Text="Приоритет: " FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Priority}" FontSize="10" FontWeight="Bold" Foreground="#A3BE8C" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Enable MSI Mode Button -->
                                                <Button Grid.Column="3" Content="ВКЛЮЧИТЬ MSI (HIGH)" Style="{StaticResource PrimaryBtnStyle}" Height="28" FontSize="10"
                                                        Click="OnEnableMsiItemClick"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Panel 2: Timers -->
                <Grid x:Name="PanelTimers" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="16" BorderBrush="#33808080" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="⏱️ Оптимизация таймеров Windows (BCDedit Low Latency)" FontWeight="Bold" FontSize="14" Foreground="White" FontFamily="Bahnschrift"/>
                            <TextBlock Text="Применяет тонкую настройку загрузчика Windows для минимизации инпут-лага мыши и клавиатуры:"
                                       FontSize="11" Foreground="#888888" Margin="0,4,0,12" FontFamily="Bahnschrift"/>

                            <Border Background="#16191E" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="• useplatformclock = false (отключение медленного таймера HPET)" Foreground="#A3BE8C" FontSize="11" FontFamily="Consolas"/>
                                    <TextBlock Text="• disabledynamictick = yes (отключение энергосберегающих тиков таймера)" Foreground="#A3BE8C" FontSize="11" FontFamily="Consolas" Margin="0,4,0,0"/>
                                    <TextBlock Text="• tscsyncpolicy = Enhanced (синхронизация частот ядер процессора)" Foreground="#A3BE8C" FontSize="11" FontFamily="Consolas" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button Content="🚀 ПРИМЕНИТЬ ОПТИМИЗАЦИЮ ТАЙМЕРОВ" Style="{StaticResource PrimaryBtnStyle}" Height="38" Click="OnApplyTimersClick"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Panel 3: Network -->
                <Grid x:Name="PanelNetwork" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="16" BorderBrush="#33808080" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🌐 Оптимизация сетевого стека для снижения пинга" FontWeight="Bold" FontSize="14" Foreground="White" FontFamily="Bahnschrift"/>
                            <TextBlock Text="Отключает искусственное ограничение пропускной способности сети и задержку накопления TCP-пакетов:"
                                       FontSize="11" Foreground="#888888" Margin="0,4,0,12" FontFamily="Bahnschrift"/>

                            <Border Background="#16191E" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="• NetworkThrottlingIndex = 0xFFFFFFFF (отключение троттлинга пакетов)" Foreground="#88C0D0" FontSize="11" FontFamily="Consolas"/>
                                    <TextBlock Text="• SystemResponsiveness = 0 (100% приоритет сети для игр)" Foreground="#88C0D0" FontSize="11" FontFamily="Consolas" Margin="0,4,0,0"/>
                                    <TextBlock Text="• TcpAckFrequency = 1 &amp; TCPNoDelay = 1 (мгновенный отклик сетевых пакетов)" Foreground="#88C0D0" FontSize="11" FontFamily="Consolas" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button Content="⚡ ПРИМЕНИТЬ СЕТЕВЫЕ ИГРОВЫЕ ТВphaseИКИ" Style="{StaticResource PrimaryBtnStyle}" Height="38" Click="OnApplyNetworkClick"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Panel 4: Power & CPU -->
                <Grid x:Name="PanelPower" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="16" BorderBrush="#33808080" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="⚡ Схема питания Ultimate Performance и Core Unparking" FontWeight="Bold" FontSize="14" Foreground="White" FontFamily="Bahnschrift"/>
                            <TextBlock Text="Активирует скрытую схему «Максимальная производительность» и отключает парковку ядер процессора:"
                                       FontSize="11" Foreground="#888888" Margin="0,4,0,12" FontFamily="Bahnschrift"/>

                            <Border Background="#16191E" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="• Разблокировка скрытой схемы электропитания Ultimate Performance" Foreground="#EBCB8B" FontSize="11" FontFamily="Consolas"/>
                                    <TextBlock Text="• Core Parking = 0% (все ядра процессора активны на 100% без задержек просыпания)" Foreground="#EBCB8B" FontSize="11" FontFamily="Consolas" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button Content="🔋 АКТИВИРОВАТЬ ULTIMATE GAMING СХЕМУ" Style="{StaticResource PrimaryBtnStyle}" Height="38" Click="OnApplyPowerClick"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
