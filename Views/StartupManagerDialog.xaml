<Window x:Class="WinClickWpf.Views.StartupManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер автозагрузки"
        Width="750" Height="630"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#141619"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1E2228"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5E81AC"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C566A"/>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4C566A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Background" Value="#252A32"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#335E81AC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D4450"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Action Button Style (Open Folder, Web Search, Delete) -->
        <Style x:Key="IconActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#222730"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33808080"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D4450"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5E81AC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Animated Smooth Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="20">
                            <Border x:Name="BackgroundBorder" CornerRadius="10" BorderBrush="#444444" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush x:Name="BgBrush" Color="#2A2E33"/>
                                </Border.Background>
                            </Border>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="ThumbBrush" Color="#888888"/>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#5E81AC" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="ThumbBrush" Storyboard.TargetProperty="Color" To="#FFFFFF" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#2A2E33" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="ThumbBrush" Storyboard.TargetProperty="Color" To="#888888" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DarkBgBrush}" CornerRadius="12" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="20" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="DialogScale" ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Fill="White" Opacity="0.7" Data="M13 2.05v3.03c3.39.49 6 3.39 6 6.92 0 .9-.18 1.75-.48 2.54l2.6 1.53c.56-1.24.88-2.62.88-4.07 0-5.18-3.95-9.45-9-9.95zM12 19c-3.87 0-7-3.13-7-7 0-3.53 2.61-6.43 6-6.92V2.05c-5.05.5-9 4.76-9 9.95 0 5.52 4.47 10 9.99 10 3.31 0 6.24-1.61 8.04-4.09l-2.43-1.44C16.27 18.06 14.28 19 12 19z"/>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="Менеджер автозагрузки"
                                   FontFamily="Bahnschrift"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Управление автозапуском программ, задач планировщика и сторонних служб"
                                   FontFamily="Bahnschrift"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Border Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnCloseClick" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <TextBlock Text="✕" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Category Tabs (Программы / Планировщик / Службы) -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tab 1: Programs -->
                <Border Grid.Column="0" x:Name="TabPrograms" Background="#5E81AC" CornerRadius="7" Height="34" Cursor="Hand"
                        MouseLeftButtonDown="OnTabProgramsClick">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📦 Программы" FontWeight="Bold" FontFamily="Bahnschrift" FontSize="12" Foreground="White"/>
                        <Border Background="#33FFFFFF" CornerRadius="8" Padding="5,1,5,1" Margin="6,0,0,0">
                            <TextBlock x:Name="TxtCountPrograms" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tab 2: Tasks -->
                <Border Grid.Column="2" x:Name="TabTasks" Background="#1E2228" BorderBrush="#33808080" BorderThickness="1" CornerRadius="7" Height="34" Cursor="Hand"
                        MouseLeftButtonDown="OnTabTasksClick">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏰ Планировщик" FontWeight="Bold" FontFamily="Bahnschrift" FontSize="12" Foreground="#AAAAAA"/>
                        <Border Background="#252A32" CornerRadius="8" Padding="5,1,5,1" Margin="6,0,0,0">
                            <TextBlock x:Name="TxtCountTasks" Text="0" FontSize="10" FontWeight="Bold" Foreground="#888888"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tab 3: Services -->
                <Border Grid.Column="4" x:Name="TabServices" Background="#1E2228" BorderBrush="#33808080" BorderThickness="1" CornerRadius="7" Height="34" Cursor="Hand"
                        MouseLeftButtonDown="OnTabServicesClick">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⚙️ Службы автозапуска" FontWeight="Bold" FontFamily="Bahnschrift" FontSize="12" Foreground="#AAAAAA"/>
                        <Border Background="#252A32" CornerRadius="8" Padding="5,1,5,1" Margin="6,0,0,0">
                            <TextBlock x:Name="TxtCountServices" Text="0" FontSize="10" FontWeight="Bold" Foreground="#888888"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search Bar & Add Button -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" CornerRadius="6" BorderBrush="#33808080" BorderThickness="1" Padding="10,0,10,0" Height="32">
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="🔍 Поиск по названию или издателю..." Foreground="#555555" FontSize="11" FontFamily="Bahnschrift" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="White" BorderThickness="0"
                                 FontSize="11" FontFamily="Bahnschrift" VerticalAlignment="Center" TextChanged="OnSearchTextChanged"/>
                    </Grid>
                </Border>

                <!-- Add Custom Program Button -->
                <Button Grid.Column="2" Content="➕ ДОБАВИТЬ" Style="{StaticResource PrimaryBtnStyle}" Click="OnAddProgramClick" ToolTip="Добавить любую программу в автозапуск"/>

                <!-- Refresh Button -->
                <Button Grid.Column="4" Content="🔄" Width="32" Style="{StaticResource SecondaryBtnStyle}" Click="OnRefreshClick" ToolTip="Обновить список"/>
            </Grid>

            <!-- Items List -->
            <Grid Grid.Row="3">
                <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" BorderBrush="#33808080" BorderThickness="1" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                        <ItemsControl x:Name="ListStartup">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16191E" CornerRadius="6" BorderBrush="#252A32" BorderThickness="1" Margin="0,0,0,6" Padding="12,10,12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Main Info -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                                    
                                                    <!-- Impact Badge -->
                                                    <Border Background="#252A32" CornerRadius="4" Padding="6,2,6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Влияние: " FontSize="9" Foreground="#888888"/>
                                                            <TextBlock Text="{Binding Impact}" FontSize="9" FontWeight="Bold" Foreground="{Binding ImpactColor}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Location Badge -->
                                                    <Border Background="#1A202C" CornerRadius="4" Padding="6,2,6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LocationType}" FontSize="9" Foreground="#5E81AC"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Publisher & Command Details -->
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Publisher}" FontSize="10" Foreground="#888888" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text=" • " FontSize="10" Foreground="#555555"/>
                                                    <TextBlock Text="{Binding Command}" FontSize="10" Foreground="#666666" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Buttons: Open Folder, Search Online, Delete -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Open Folder -->
                                                <Button Style="{StaticResource IconActionButtonStyle}" Margin="0,0,4,0" ToolTip="Открыть папку с файлом в Проводнике"
                                                        Click="OnOpenFileLocationClick">
                                                    <Viewbox Width="12" Height="12">
                                                        <Path Fill="White" Opacity="0.7" Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
                                                    </Viewbox>
                                                </Button>

                                                <!-- Search Online -->
                                                <Button Style="{StaticResource IconActionButtonStyle}" Margin="0,0,4,0" ToolTip="Найти информацию о процессе в Google"
                                                        Click="OnSearchOnlineClick">
                                                    <Viewbox Width="12" Height="12">
                                                        <Path Fill="White" Opacity="0.7" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                                    </Viewbox>
                                                </Button>

                                                <!-- Delete -->
                                                <Button Style="{StaticResource IconActionButtonStyle}" ToolTip="Удалить запись из автозагрузки"
                                                        Click="OnDeleteItemClick">
                                                    <Viewbox Width="12" Height="12">
                                                        <Path Fill="#BF616A" Opacity="0.8" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>

                                            <!-- Status Text -->
                                            <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Width="68" TextAlignment="Right"/>

                                            <!-- Toggle Switch -->
                                            <CheckBox Grid.Column="5" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center" Click="OnItemToggleClick"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Loading Indicator Overlay with Spinner Animation -->
                <Border x:Name="LoadingOverlay" Background="#E61E2228" CornerRadius="8" BorderBrush="#33808080" BorderThickness="1" Visibility="Visible" Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Animated Spinning Ring -->
                        <Border Width="42" Height="42" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,14">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360"
                                                             Duration="0:0:0.9"
                                                             RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Viewbox Width="34" Height="34">
                                <Path Fill="#5E81AC" Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Сканирование автозагрузки Windows..."
                                   FontFamily="Bahnschrift"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Анализ реестра, планировщика задач и служб..."
                                   FontFamily="Bahnschrift"
                                   FontSize="11"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Summary Bar -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <TextBlock x:Name="TxtSummary" Text="Всего: 0 записей • Включено: 0 • Отключено: 0"
                           FontFamily="Bahnschrift" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
