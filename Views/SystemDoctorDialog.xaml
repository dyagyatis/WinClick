<Window x:Class="WinClickWpf.Views.SystemDoctorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доктор системы (System Health &amp; Repair)"
        Width="740" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#141619"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1E2228"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5E81AC"/>

        <!-- Action Card Button Style -->
        <Style x:Key="DoctorCardBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#1A1E24"/>
            <Setter Property="BorderBrush" Value="#335E81AC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,0,14,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A303A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5E81AC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Background" Value="#252A32"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#335E81AC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D4450"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DarkBgBrush}" CornerRadius="12" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="20" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="DialogScale" ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Fill="#BF616A" Data="M19 3H5c-1.1 0-1.99.9-1.99 2L3 19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 11h-4v4h-4v-4H6v-4h4V6h4v4h4v4z"/>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="Доктор системы (System Health &amp; Repair)"
                                   FontFamily="Bahnschrift"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="#BF616A"/>
                        <TextBlock Text="Автоматическая проверка целостности, восстановление системных файлов и ремонт сети"
                                   FontFamily="Bahnschrift"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Border Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnCloseClick" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <TextBlock Text="✕" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- SFC & DISM Check -->
                    <Button x:Name="BtnSfcDism" Style="{StaticResource DoctorCardBtnStyle}" Click="OnRunSfcDismClick">
                        <Grid HorizontalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🩺 Восстановление файлов (SFC + DISM)" FontWeight="Bold" Foreground="#A3BE8C" FontSize="12" FontFamily="Bahnschrift"/>
                                <TextBlock Text="Полное сканирование и исправление поврежденных системных библиотек Windows." FontSize="10" Foreground="#888888" FontFamily="Bahnschrift" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Network Stack Reset -->
                    <Button x:Name="BtnResetNet" Style="{StaticResource DoctorCardBtnStyle}" Click="OnResetNetworkClick">
                        <Grid HorizontalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🌐 Сброс и ремонт сети (Winsock / IP)" FontWeight="Bold" Foreground="#88C0D0" FontSize="12" FontFamily="Bahnschrift"/>
                                <TextBlock Text="Очистка DNS, сброс каталога Winsock и адаптеров при проблемах с интернетом." FontSize="10" Foreground="#888888" FontFamily="Bahnschrift" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Windows Store Repair -->
                    <Button x:Name="BtnFixStore" Style="{StaticResource DoctorCardBtnStyle}" Click="OnRepairStoreClick">
                        <Grid HorizontalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="📦 Восстановление Microsoft Store" FontWeight="Bold" Foreground="#EBCB8B" FontSize="12" FontFamily="Bahnschrift"/>
                                <TextBlock Text="Сброс кэша WSReset и перерегистрация всех служб Магазина Windows." FontSize="10" Foreground="#888888" FontFamily="Bahnschrift" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Live Log -->
                <Border Grid.Column="2" Background="#101216" CornerRadius="8" BorderBrush="#252A32" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📟 Журнал диагностики и ремонта:" FontSize="11" FontWeight="Bold" Foreground="#888888" FontFamily="Bahnschrift" Margin="0,0,0,6"/>

                        <ScrollViewer Grid.Row="1" x:Name="ScrollLog" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLog" Text="Выберите операцию диагностики или восстановления слева..."
                                       FontFamily="Consolas" FontSize="11" Foreground="#00FF66" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
