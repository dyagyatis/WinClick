<Window x:Class="WinClickWpf.Views.CompactOsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPACT OS LZX (для SSD / NVMe)"
        Width="740" Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#141619"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1E2228"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5E81AC"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C566A"/>

        <!-- Mode Action Button Style -->
        <Style x:Key="ModeCardButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="#1A1E24"/>
            <Setter Property="BorderBrush" Value="#335E81AC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,0,12,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A303A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5E81AC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Background" Value="#252A32"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#335E81AC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D4450"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DarkBgBrush}" CornerRadius="12" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="20" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="DialogScale" ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Fill="#A3BE8C" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.64-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="COMPACT OS LZX (для SSD / NVMe)"
                                   FontFamily="Bahnschrift"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="#A3BE8C"/>
                        <TextBlock Text="Максимальное системное сжатие файлов алгоритмом LZX / LZMS (Ghost Toolbox style)"
                                   FontFamily="Bahnschrift"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Border Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnCloseClick" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <TextBlock Text="✕" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- HDD Warning Banner -->
            <Border Grid.Row="1" Background="#261719" BorderBrush="#BF616A" BorderThickness="1" CornerRadius="8" Padding="12,8,12,8" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="/_\ HDD Highly Not recommended to Use LZX /_\" FontWeight="Bold" Foreground="#BF616A" FontSize="11" FontFamily="Bahnschrift"/>
                        <TextBlock Text="Сжатие LZX требует быстрой дисковой подсистемы. На HDD может вызывать задержки распаковки. Время: 5-10 мин на SSD, 30м-1ч на HDD."
                                   Foreground="#D08770" FontSize="10" FontFamily="Bahnschrift" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Target Folders Overview Card -->
            <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" BorderBrush="#33808080" BorderThickness="1" CornerRadius="8" Padding="12,8,12,8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Папки, сжимаемые в режиме Compact OS LZX [LZMS]:" FontSize="11" FontWeight="Bold" Foreground="LightGray" FontFamily="Bahnschrift" Margin="0,0,0,6"/>
                    <WrapPanel Orientation="Horizontal">
                        <Border Background="#201518" BorderBrush="#88BF616A" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,6,4">
                            <TextBlock Text="📁 C:\Program Files" FontSize="10" FontFamily="Consolas" Foreground="#FF6B6B"/>
                        </Border>
                        <Border Background="#201518" BorderBrush="#88BF616A" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,6,4">
                            <TextBlock Text="📁 C:\Program Files (x86)" FontSize="10" FontFamily="Consolas" Foreground="#FF6B6B"/>
                        </Border>
                        <Border Background="#201518" BorderBrush="#88BF616A" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,6,4">
                            <TextBlock Text="📁 C:\ProgramData" FontSize="10" FontFamily="Consolas" Foreground="#FF6B6B"/>
                        </Border>
                        <Border Background="#201518" BorderBrush="#88BF616A" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,6,4">
                            <TextBlock Text="📁 C:\Users" FontSize="10" FontFamily="Consolas" Foreground="#FF6B6B"/>
                        </Border>
                        <Border Background="#201518" BorderBrush="#88BF616A" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,6,4">
                            <TextBlock Text="📁 C:\Windows" FontSize="10" FontFamily="Consolas" Foreground="#FF6B6B"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Actions Grid & Live Console Output -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 5 Ghost Toolbox Mode Buttons -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- [1] Compact OS LZX [LZMS] -->
                        <Button x:Name="BtnMode1" Style="{StaticResource ModeCardButtonStyle}" Click="OnMode1Click">
                            <Grid HorizontalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="[1] | COMPACT OS LZX [LZMS]" FontWeight="Bold" Foreground="#A3BE8C" FontSize="11" FontFamily="Bahnschrift"/>
                                    <TextBlock Text="Полное сжатие 5 ключевых папок" FontSize="9" Foreground="#888888" FontFamily="Bahnschrift"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- [2] Compact OS Normal -->
                        <Button x:Name="BtnMode2" Style="{StaticResource ModeCardButtonStyle}" Click="OnMode2Click">
                            <Grid HorizontalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="[2] | COMPACT OS NORMAL" FontWeight="Bold" Foreground="#88C0D0" FontSize="11" FontFamily="Bahnschrift"/>
                                    <TextBlock Text="Быстрое сжатие ядра (XPRESS8K)" FontSize="9" Foreground="#888888" FontFamily="Bahnschrift"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- [3] Compress Specific Folder [LZMS] -->
                        <Button x:Name="BtnMode3" Style="{StaticResource ModeCardButtonStyle}" Click="OnMode3Click">
                            <Grid HorizontalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="[3] | Сжать выбранную папку [LZMS]" FontWeight="Bold" Foreground="#EBCB8B" FontSize="11" FontFamily="Bahnschrift"/>
                                    <TextBlock Text="Выбор любой папки через проводник" FontSize="9" Foreground="#888888" FontFamily="Bahnschrift"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- [4] Uncompress C:\Windows -->
                        <Button x:Name="BtnMode4" Style="{StaticResource ModeCardButtonStyle}" Click="OnMode4Click">
                            <Grid HorizontalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="[4] | Распаковать [Uncompress] C:\Windows" FontWeight="Bold" Foreground="#D08770" FontSize="11" FontFamily="Bahnschrift"/>
                                    <TextBlock Text="Возврат несжатого состояния Windows" FontSize="9" Foreground="#888888" FontFamily="Bahnschrift"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- [5] Uncompress Specific Folder -->
                        <Button x:Name="BtnMode5" Style="{StaticResource ModeCardButtonStyle}" Click="OnMode5Click">
                            <Grid HorizontalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="[5] | Распаковать выбранную папку" FontWeight="Bold" Foreground="#BF616A" FontSize="11" FontFamily="Bahnschrift"/>
                                    <TextBlock Text="Возврат несжатого состояния папки" FontSize="9" Foreground="#888888" FontFamily="Bahnschrift"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Live Output Log Box -->
                <Border Grid.Column="2" Background="#101216" CornerRadius="8" BorderBrush="#252A32" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="📟 Консоль выполнения (Live Log):" FontSize="11" FontWeight="Bold" Foreground="#888888" FontFamily="Bahnschrift"/>
                            <TextBlock x:Name="TxtStatus" Text="Готово к работе" FontSize="11" Foreground="#A3BE8C" FontFamily="Bahnschrift" Margin="10,0,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" x:Name="ScrollLog" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLog" Text="Выберите опцию слева для начала сжатия или распаковки..."
                                       FontFamily="Consolas" FontSize="11" Foreground="#00FF66" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Actions -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Text="💡 Сжатие выполняется в фоновом режиме через compact.exe" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
