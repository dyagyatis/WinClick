<Window x:Class="WinClickWpf.Views.SoftwareInstallerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка программ"
        Width="750" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#141619"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1E2228"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5E81AC"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C566A"/>

        <!-- Action Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Background" Value="#5E81AC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0,14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4C566A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#2A2E33"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Background" Value="#252A32"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#335E81AC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D4450"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryChipStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#1E2228" CornerRadius="13" BorderBrush="#33808080" BorderThickness="1" Padding="10,0,10,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2E33"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5E81AC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5E81AC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="2">
                            <BulletDecorator Background="Transparent">
                                <BulletDecorator.Bullet>
                                    <Grid Width="18" Height="18">
                                        <Border x:Name="Border" CornerRadius="4" Background="Transparent" BorderBrush="White" BorderThickness="1"/>
                                        <Path x:Name="CheckMark" Opacity="0" Stroke="#5E81AC" StrokeThickness="2" Data="M3,9 L7,13 L15,5" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <ScaleTransform x:Name="CheckScale" ScaleX="0" ScaleY="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </BulletDecorator.Bullet>
                                <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </BulletDecorator>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.0" To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.0" To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5E81AC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5E81AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DarkBgBrush}" CornerRadius="12" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="20" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="DialogScale" ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="DialogScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📥" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Установка программ"
                                   FontFamily="Bahnschrift"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Быстрая и тихая установка проверенного софта для чистой системы"
                                   FontFamily="Bahnschrift"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Border Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnCloseClick" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <TextBlock Text="✕" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Search & Actions Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search + Quick buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" CornerRadius="6" BorderBrush="#33808080" BorderThickness="1" Margin="0,0,10,0">
                        <TextBox x:Name="TxtSearch"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="8,6,8,6"
                                 FontFamily="Bahnschrift"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 TextChanged="OnSearchTextChanged"/>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="★ Рекомендуемые" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,5,0" Click="OnSelectRecommendedClick"/>
                        <Button Content="Выбрать все" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,5,0" Click="OnSelectAllClick"/>
                        <Button Content="Снять все" Style="{StaticResource SecondaryBtnStyle}" Click="OnDeselectAllClick"/>
                    </StackPanel>
                </Grid>

                <!-- Category Chips -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0">
                    <StackPanel x:Name="PnlCategoryChips" Orientation="Horizontal">
                        <RadioButton Content="Все" Style="{StaticResource CategoryChipStyle}" IsChecked="True" Checked="OnCategoryFilterChanged"/>
                        <RadioButton Content="Браузеры" Style="{StaticResource CategoryChipStyle}" Checked="OnCategoryFilterChanged"/>
                        <RadioButton Content="Архиваторы и утилиты" Style="{StaticResource CategoryChipStyle}" Checked="OnCategoryFilterChanged"/>
                        <RadioButton Content="Мессенджеры" Style="{StaticResource CategoryChipStyle}" Checked="OnCategoryFilterChanged"/>
                        <RadioButton Content="Медиа" Style="{StaticResource CategoryChipStyle}" Checked="OnCategoryFilterChanged"/>
                        <RadioButton Content="Игры" Style="{StaticResource CategoryChipStyle}" Checked="OnCategoryFilterChanged"/>
                        <RadioButton Content="Диагностика" Style="{StaticResource CategoryChipStyle}" Checked="OnCategoryFilterChanged"/>
                        <RadioButton Content="Разработка" Style="{StaticResource CategoryChipStyle}" Checked="OnCategoryFilterChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Apps Catalog List -->
            <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" CornerRadius="8" BorderBrush="#33808080" BorderThickness="1" Padding="8">
                <ScrollViewer x:Name="ScrollCatalog" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                    <ItemsControl x:Name="ListCatalog">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16191E"
                                        CornerRadius="6"
                                        BorderBrush="#252A32"
                                        BorderThickness="1"
                                        Margin="4"
                                        Padding="10,8,10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="OnItemCheckChanged" Unchecked="OnItemCheckChanged">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"/>
                                            </CheckBox>
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#888888" Margin="26,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="1" Background="#20242B" CornerRadius="4" Padding="6,2,6,2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Status}" FontSize="9" Foreground="{Binding StatusColor}" FontFamily="Bahnschrift"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Live Install Log Panel -->
            <Border Grid.Row="3" x:Name="PnlLog" Background="#0E1012" CornerRadius="6" BorderBrush="#22272E" BorderThickness="1" Margin="0,10,0,0" Padding="8" Height="90" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0" x:Name="ProgInstall" Height="3" Foreground="{StaticResource AccentBrush}" Background="#22272E" BorderThickness="0" Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" x:Name="ScrollLog" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="10" Foreground="#88C0D0" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Bottom Actions Bar -->
            <Grid Grid.Row="4" Margin="0,15,0,0">
                <TextBlock x:Name="TxtStatusCount"
                           Text="Выбрано: 0 программ"
                           FontFamily="Bahnschrift"
                           FontSize="12"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>

                <Button x:Name="BtnInstall" Content="УСТАНОВИТЬ ВЫБРАННЫЕ" Style="{StaticResource PrimaryBtnStyle}" HorizontalAlignment="Right" Click="OnInstallClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
